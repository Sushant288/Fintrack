generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TxType {
  INCOME
  EXPENSE
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ImportStatus {
  PENDING
  COMPLETED
  FAILED
  UNDONE
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  OTHER
}

enum JobStatus {
  RUNNING
  SUCCESS
  FAILED
}

model User {
  id                String   @id @default(uuid())
  name              String   @db.VarChar(60)
  email             String   @unique @db.VarChar(254)
  passwordHash      String
  currency          String   @default("INR") @db.VarChar(3)
  timezone          String   @default("Asia/Kolkata") @db.VarChar(64)
  alertThresholds   Int[]    @default([80, 100])
  alertInAppEnabled Boolean  @default(true)
  alertEmailEnabled Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  categories     Category[]
  transactions   Transaction[]
  budgets        Budget[]
  overallBudgets OverallBudget[]
  recurringRules RecurringRule[]
  goals          SavingsGoal[]
  contributions  GoalContribution[]
  alerts         Alert[]
  reports        Report[]
  importBatches  ImportBatch[]
  refreshTokens  RefreshToken[]
}

model Category {
  id         String   @id @default(uuid())
  userId     String
  name       String   @db.VarChar(40)
  type       TxType
  color      String   @default("#6366f1") @db.VarChar(7)
  icon       String   @default("tag") @db.VarChar(40)
  isArchived Boolean  @default(false)
  isDefault  Boolean  @default(false)
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Category[] @relation("CategoryTree")

  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]

  @@unique([userId, name, type])
  @@unique([id, userId, type])
  @@index([userId, type, isArchived])
}

model Transaction {
  id            String        @id @default(uuid())
  userId        String
  categoryId    String
  type          TxType
  amount        Decimal       @db.Decimal(12, 2)
  date          DateTime      @db.Date
  description   String?       @db.VarChar(255)
  paymentMethod PaymentMethod @default(OTHER)
  recurringId   String?
  importBatchId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category          @relation(fields: [categoryId, userId, type], references: [id, userId, type], onDelete: NoAction, onUpdate: Restrict)
  recurring    RecurringRule?    @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  importBatch  ImportBatch?      @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  contribution GoalContribution?

  @@unique([recurringId, date])
  @@index([userId, date])
  @@index([userId, categoryId, date])
  @@index([userId, type, date])
  @@index([importBatchId])
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  type       TxType   @default(EXPENSE) // always EXPENSE (CHECK); enables the composite FK to Category
  month      Int
  year       Int
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId, userId, type], references: [id, userId, type], onDelete: NoAction, onUpdate: Restrict)
  alerts   Alert[]

  @@unique([userId, categoryId, month, year])
  @@unique([id, userId])
  @@index([userId, year, month])
}

model OverallBudget {
  id        String   @id @default(uuid())
  userId    String
  month     Int
  year      Int
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
}

model RecurringRule {
  id            String        @id @default(uuid())
  userId        String
  categoryId    String
  type          TxType
  amount        Decimal       @db.Decimal(12, 2)
  description   String?       @db.VarChar(255)
  paymentMethod PaymentMethod @default(OTHER)
  frequency     Frequency
  startDate     DateTime      @db.Date
  endDate       DateTime?     @db.Date
  nextRunDate   DateTime      @db.Date // always computed from startDate + N periods (month-end safe)
  isActive      Boolean       @default(true)
  lastRunAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId, userId, type], references: [id, userId, type], onDelete: NoAction, onUpdate: Restrict)
  transactions Transaction[]

  @@index([isActive, nextRunDate])
  @@index([userId])
}

model SavingsGoal {
  id            String     @id @default(uuid())
  userId        String
  name          String     @db.VarChar(80)
  targetAmount  Decimal    @db.Decimal(12, 2)
  currentAmount Decimal    @default(0) @db.Decimal(12, 2) // must always equal SUM(contributions)
  deadline      DateTime?  @db.Date
  icon          String     @default("target") @db.VarChar(40)
  color         String     @default("#10b981") @db.VarChar(7)
  status        GoalStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@unique([id, userId])
  @@index([userId, status])
}

model GoalContribution {
  id            String   @id @default(uuid())
  goalId        String
  userId        String
  amount        Decimal  @db.Decimal(12, 2) // positive = deposit, negative = withdrawal
  note          String?  @db.VarChar(255)
  transactionId String?  @unique
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        SavingsGoal  @relation(fields: [goalId, userId], references: [id, userId], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([goalId, createdAt])
  @@index([userId])
}

model Alert {
  id        String   @id @default(uuid())
  userId    String
  budgetId  String
  threshold Int
  month     Int
  year      Int
  message   String   @db.VarChar(255)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  budget Budget @relation(fields: [budgetId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([budgetId, threshold])
  @@index([userId, isRead, createdAt])
}

model Report {
  id          String   @id @default(uuid())
  userId      String
  month       Int
  year        Int
  dataJson    Json
  pdfPath     String?
  generatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
}

model ImportBatch {
  id           String       @id @default(uuid())
  userId       String
  fileName     String       @db.VarChar(255)
  rowsTotal    Int
  rowsImported Int          @default(0)
  status       ImportStatus @default(PENDING)
  createdAt    DateTime     @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model JobRun {
  id           String    @id @default(uuid())
  jobName      String    @db.VarChar(60)
  status       JobStatus @default(RUNNING)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  processed    Int       @default(0)
  failed       Int       @default(0)
  errorMessage String?

  @@index([jobName, startedAt])
}
