# Application environment (development|test|production)
NODE_ENV=development
# Server port
PORT=4000
# Database connection string
DATABASE_URL="postgresql://fintrack:fintrack_dev@localhost:5432/fintrack"
# Secret for HMAC SHA-256 JWT access tokens (min 32 chars)
JWT_ACCESS_SECRET="your-super-secret-jwt-access-token-key-at-least-32-chars"
# Access token lifespan in minutes
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token lifespan in days
REFRESH_TOKEN_TTL_DAYS=7
# Bcrypt hash calculation cost factor (10-14)
BCRYPT_COST=12
# Allowed frontend origins (comma-separated list of valid URLs)
CLIENT_URL="http://localhost:5173"
# Cookie sameSite policy (lax|strict|none)
COOKIE_SAMESITE=lax
# Reverse proxy trust level (hops count)
TRUST_PROXY=0
# General API rate limit max requests
GENERAL_RATE_MAX=300
# General API rate limit window in minutes
GENERAL_RATE_WINDOW_MIN=15
# Auth failed login rate limit max attempts
AUTH_RATE_MAX=10
# Auth failed login rate limit window in minutes
AUTH_RATE_WINDOW_MIN=15
# Registration rate limit max attempts
REGISTER_RATE_MAX=10
# Registration rate limit window in minutes
REGISTER_RATE_WINDOW_MIN=60
# Logging verbosity level (debug|info|warn|error)
LOG_LEVEL=info
# Whether background scheduled jobs are enabled (true/false)
JOBS_ENABLED=true
# Whether to run catch-up job runs on server startup (true/false)
RUN_JOBS_ON_STARTUP=true
# Cron expression for recurring transactions generation job (default hourly: 5 * * * *)
RECURRING_CRON="5 * * * *"
# Maximum manual recurring process requests per rate limit window
PROCESS_RATE_MAX=6
# Rate limit window in minutes for manual recurring process endpoint
PROCESS_RATE_WINDOW_MIN=1

# Module B4: Scheduled jobs & analytics
# Cron expression for monthly report generator job (default 1st of month at 02:15: 15 2 1 * *)
REPORT_CRON="15 2 1 * *"
# Cron expression for daily cleanup job (default daily at 03:30: 30 3 * * *)
CLEANUP_CRON="30 3 * * *"
# Cron expression for daily alert digest job (default daily at 08:00: 0 8 * * *)
DIGEST_CRON="0 8 * * *"

# Import rate limiting (preview & confirm)
IMPORT_RATE_MAX=10
IMPORT_RATE_WINDOW_MIN=15

# Heavy endpoint rate limiting (analytics, export, reports, pdf)
HEAVY_RATE_MAX=20
HEAVY_RATE_WINDOW_MIN=15

# Email delivery (optional SMTP configuration)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="user@example.com"
# SMTP_PASS="secret"
# MAIL_FROM="FinTrack <no-reply@fintrack.local>"
