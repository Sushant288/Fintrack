# Application environment (development|test|production)
NODE_ENV=development
# Server port
PORT=4000
# Database connection string
DATABASE_URL="postgresql://fintrack:fintrack_dev@localhost:5432/fintrack"
# Secret for HMAC SHA-256 JWT access tokens (min 32 chars)
JWT_ACCESS_SECRET="your-super-secret-jwt-access-token-key-at-least-32-chars"
# Access token lifespan in minutes
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token lifespan in days
REFRESH_TOKEN_TTL_DAYS=7
# Bcrypt hash calculation cost factor (10-14)
BCRYPT_COST=12
# Allowed frontend origins (comma-separated list of valid URLs)
CLIENT_URL="http://localhost:5173"
# Cookie sameSite policy (lax|strict|none)
COOKIE_SAMESITE=lax
# Reverse proxy trust level (hops count)
TRUST_PROXY=0
# General API rate limit max requests
GENERAL_RATE_MAX=300
# General API rate limit window in minutes
GENERAL_RATE_WINDOW_MIN=15
# Auth failed login rate limit max attempts
AUTH_RATE_MAX=10
# Auth failed login rate limit window in minutes
AUTH_RATE_WINDOW_MIN=15
# Registration rate limit max attempts
REGISTER_RATE_MAX=10
# Registration rate limit window in minutes
REGISTER_RATE_WINDOW_MIN=60
# Logging verbosity level (debug|info|warn|error)
LOG_LEVEL=info
